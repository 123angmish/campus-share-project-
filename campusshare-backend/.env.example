# ==========================================
# CampusShare Backend Environment Variables
# ==========================================

# Server Port
PORT=8080

# Database Configuration (Defaults to persistent local file database ./data/campussharedb)
# For PostgreSQL: jdbc:postgresql://localhost:5432/campusshare
SPRING_DATASOURCE_URL=jdbc:h2:file:./data/campussharedb;MODE=PostgreSQL;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT Security
JWT_SECRET=your-256-bit-secret-key-change-this-in-production-environments-very-secure
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=2592000000

# CORS & Frontend URL
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Allowed Student Email Domains (* allows all emails)
ALLOWED_EMAIL_DOMAINS=*,gmail.com,yahoo.com,outlook.com,college.edu,student.edu

# Optional Email Service (Gmail SMTP)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-college-email@gmail.com
MAIL_PASSWORD=your-app-password

# Optional Razorpay Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
